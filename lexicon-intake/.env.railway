# Railway Environment Variables Template
# Copy these to your Railway project environment variables

# Database (Railway Postgres addon)
DATABASE_URL=postgresql+asyncpg://username:password@host:port/database

# Redis (Railway Redis addon)
REDIS_URL=redis://host:port/0

# Security
SECRET_KEY=your-production-secret-key
WEBHOOK_SIGNING_SECRET=your-production-webhook-secret
ADMIN_API_KEY=your-production-admin-api-key

# Twilio SMS
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=your-twilio-phone-number

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=your-from-email@example.com

# Logging
LOG_LEVEL=INFO

# Port (Railway sets this automatically)
PORT=8000
